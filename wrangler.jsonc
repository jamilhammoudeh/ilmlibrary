{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilmlibrary",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ilmlibrary"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ilmlibrary",
      "database_id": "287f4e64-b950-403c-8e5f-d4c4fae3186d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ilmlibrary-files"
    }
  ],
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "summer-tree-64a0.cloudflareaccess.com",
    "CF_ACCESS_AUD": "4ca480d0d10d1d58a856b32fd7080a7360bee3c0b671fb26360724be63b1af5e",
    "FILES_PUBLIC_URL": "https://files.ilmlibrary.org"
  },
  "routes": [
    { "pattern": "www.ilmlibrary.org", "custom_domain": true },
    { "pattern": "ilmlibrary.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
