{"113:1":[{"p":1,"a":"قُلْ","e":"Say"},{"p":2,"a":"أَعُوذُ","e":"I seek refuge"},{"p":3,"a":"بِرَبِّ","e":"in (the) Lord"},{"p":4,"a":"ٱلْفَلَقِ","e":"(of) the dawn"}],"113:2":[{"p":1,"a":"مِن","e":"From"},{"p":2,"a":"شَرِّ","e":"(the) evil"},{"p":3,"a":"مَا","e":"(of) what"},{"p":4,"a":"خَلَقَ","e":"He created"}],"113:3":[{"p":1,"a":"وَمِن","e":"And from"},{"p":2,"a":"شَرِّ","e":"(the) evil"},{"p":3,"a":"غَاسِقٍ","e":"(of) darkness"},{"p":4,"a":"إِذَا","e":"when"},{"p":5,"a":"وَقَبَ","e":"it spreads"}],"113:4":[{"p":1,"a":"وَمِن","e":"And from"},{"p":2,"a":"شَرِّ","e":"(the) evil"},{"p":3,"a":"ٱلنَّفَّـٰثَـٰتِ","e":"(of) the blowers"},{"p":4,"a":"فِى","e":"in"},{"p":5,"a":"ٱلْعُقَدِ","e":"the knots"}],"113:5":[{"p":1,"a":"وَمِن","e":"And from"},{"p":2,"a":"شَرِّ","e":"(the) evil"},{"p":3,"a":"حَاسِدٍ","e":"(of) an envier"},{"p":4,"a":"إِذَا","e":"when"},{"p":5,"a":"حَسَدَ","e":"he envies"}]}