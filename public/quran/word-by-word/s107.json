{"107:1":[{"p":1,"a":"أَرَءَيْتَ","e":"Have you seen"},{"p":2,"a":"ٱلَّذِى","e":"the one who"},{"p":3,"a":"يُكَذِّبُ","e":"denies"},{"p":4,"a":"بِٱلدِّينِ","e":"the Judgment"}],"107:2":[{"p":1,"a":"فَذَٰلِكَ","e":"Then that"},{"p":2,"a":"ٱلَّذِى","e":"(is) the one who"},{"p":3,"a":"يَدُعُّ","e":"repulses"},{"p":4,"a":"ٱلْيَتِيمَ","e":"the orphan"}],"107:3":[{"p":1,"a":"وَلَا","e":"And (does) not"},{"p":2,"a":"يَحُضُّ","e":"feel the urge"},{"p":3,"a":"عَلَىٰ","e":"to"},{"p":4,"a":"طَعَامِ","e":"feed"},{"p":5,"a":"ٱلْمِسْكِينِ","e":"the poor"}],"107:4":[{"p":1,"a":"فَوَيْلٌۭ","e":"So woe"},{"p":2,"a":"لِّلْمُصَلِّينَ","e":"to those who pray"}],"107:5":[{"p":1,"a":"ٱلَّذِينَ","e":"Those who"},{"p":2,"a":"هُمْ","e":"[they]"},{"p":3,"a":"عَن","e":"about"},{"p":4,"a":"صَلَاتِهِمْ","e":"their prayers"},{"p":5,"a":"سَاهُونَ","e":"(are) neglectful"}],"107:6":[{"p":1,"a":"ٱلَّذِينَ","e":"Those who"},{"p":2,"a":"هُمْ","e":"[they]"},{"p":3,"a":"يُرَآءُونَ","e":"make show"}],"107:7":[{"p":1,"a":"وَيَمْنَعُونَ","e":"And they deny"},{"p":2,"a":"ٱلْمَاعُونَ","e":"[the] small kindnesses"}]}