{"94:1":[{"p":1,"a":"أَلَمْ","e":"Have not"},{"p":2,"a":"نَشْرَحْ","e":"We expanded"},{"p":3,"a":"لَكَ","e":"for you"},{"p":4,"a":"صَدْرَكَ","e":"your breast"}],"94:2":[{"p":1,"a":"وَوَضَعْنَا","e":"And We removed"},{"p":2,"a":"عَنكَ","e":"from you"},{"p":3,"a":"وِزْرَكَ","e":"your burden"}],"94:3":[{"p":1,"a":"ٱلَّذِىٓ","e":"Which"},{"p":2,"a":"أَنقَضَ","e":"weighed upon"},{"p":3,"a":"ظَهْرَكَ","e":"your back"}],"94:4":[{"p":1,"a":"وَرَفَعْنَا","e":"And We raised high"},{"p":2,"a":"لَكَ","e":"for you"},{"p":3,"a":"ذِكْرَكَ","e":"your reputation"}],"94:5":[{"p":1,"a":"فَإِنَّ","e":"So indeed"},{"p":2,"a":"مَعَ","e":"with"},{"p":3,"a":"ٱلْعُسْرِ","e":"the hardship"},{"p":4,"a":"يُسْرًا","e":"(is) ease"}],"94:6":[{"p":1,"a":"إِنَّ","e":"Indeed"},{"p":2,"a":"مَعَ","e":"with"},{"p":3,"a":"ٱلْعُسْرِ","e":"the hardship"},{"p":4,"a":"يُسْرًۭا","e":"(is) ease"}],"94:7":[{"p":1,"a":"فَإِذَا","e":"So when"},{"p":2,"a":"فَرَغْتَ","e":"you have finished"},{"p":3,"a":"فَٱنصَبْ","e":"then labor hard"}],"94:8":[{"p":1,"a":"وَإِلَىٰ","e":"And to"},{"p":2,"a":"رَبِّكَ","e":"your Lord"},{"p":3,"a":"فَٱرْغَب","e":"turn your attention"}]}