 with you"},{"p":3,"a":"كَيْفَ","e":"How"},{"p":4,"a":"تَحْكُمُونَ","e":"you judge"}],"37:155":[{"p":1,"a":"أَفَلَا","e":"Then will not"},{"p":2,"a":"تَذَكَّرُونَ","e":"you pay heed"}],"37:156":[{"p":1,"a":"أَمْ","e":"Or"},{"p":2,"a":"لَكُمْ","e":"(is) for you"},{"p":3,"a":"سُلْطَـٰنٌۭ","e":"an authority"},{"p":4,"a":"مُّبِينٌۭ","e":"clear"}],"37:157":[{"p":1,"a":"فَأْتُواْ","e":"Then bring"},{"p":2,"a":"بِكِتَـٰبِكُمْ","e":"your book"},{"p":3,"a":"إِن","e":"if"},{"p":4,"a":"كُنتُمْ","e":"you are"},{"p":5,"a":"صَـٰدِقِينَ","e":"truthful"}],"37:158":[{"p":1,"a":"وَجَعَلُواْ","e":"And they have made"},{"p":2,"a":"بَيْنَهُۥ","e":"between Him"},{"p":3,"a":"وَبَيْنَ","e":"and between"},{"p":4,"a":"ٱلْجِنَّةِ","e":"the jinn"},{"p":5,"a":"نَسَبًۭا ۚ","e":"a relationship"},{"p":6,"a":"وَلَقَدْ","e":"but certainly"},{"p":7,"a":"عَلِمَتِ","e":"know"},{"p":8,"a":"ٱلْجِنَّةُ","e":"the jinn"},{"p":9,"a":"إِنَّهُمْ","e":"that they"},{"p":10,"a":"لَمُحْضَرُونَ","e":"(will) surely be brought"}],"37:159":[{"p":1,"a":"سُبْحَـٰنَ","e":"Glory be"},{"p":2,"a":"ٱللَّهِ","e":"(to) Allah"},{"p":3,"a":"عَمَّا","e":"above what"},{"p":4,"a":"يَصِفُونَ","e":"they attribute"}],"37:160":[{"p":1,"a":"إِلَّا","e":"Except"},{"p":2,"a":"عِبَادَ","e":"(the) slaves"},{"p":3,"a":"ٱللَّهِ","e":"(of) Allah"},{"p":4,"a":"ٱلْمُخْلَصِينَ","e":"the chosen"}],"37:161":[{"p":1,"a":"فَإِنَّكُمْ","e":"So indeed, you"},{"p":2,"a":"وَمَا","e":"and what"},{"p":3,"a":"تَعْبُدُونَ","e":"you worship"}],"37:162":[{"p":1,"a":"مَآ","e":"Not"},{"p":2,"a":"أَنتُمْ","e":"you"},{"p":3,"a":"عَلَيْهِ","e":"from Him"},{"p":4,"a":"بِفَـٰتِنِينَ","e":"can tempt away (anyone)"}],"37:163":[{"p":1,"a":"إِلَّا","e":"Except"},{"p":2,"a":"مَنْ","e":"who"},{"p":3,"a":"هُوَ","e":"he"},{"p":4,"a":"صَالِ","e":"(is) to burn"},{"p":5,"a":"ٱلْجَحِيمِ","e":"(in) the Hellfire"}],"37:164":[{"p":1,"a":"وَمَا","e":"And not"},{"p":2,"a":"مِنَّآ","e":"among us"},{"p":3,"a":"إِلَّا","e":"except"},{"p":4,"a":"لَهُۥ","e":"for him"},{"p":5,"a":"مَقَام