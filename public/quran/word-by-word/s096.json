{"96:1":[{"p":1,"a":"ٱقْرَأْ","e":"Read"},{"p":2,"a":"بِٱسْمِ","e":"in (the) name"},{"p":3,"a":"رَبِّكَ","e":"(of) your Lord"},{"p":4,"a":"ٱلَّذِى","e":"the One Who"},{"p":5,"a":"خَلَقَ","e":"created "}],"96:2":[{"p":1,"a":"خَلَقَ","e":"He created"},{"p":2,"a":"ٱلْإِنسَـٰنَ","e":"man"},{"p":3,"a":"مِنْ","e":"from"},{"p":4,"a":"عَلَقٍ","e":"a clinging substance"}],"96:3":[{"p":1,"a":"ٱقْرَأْ","e":"Read"},{"p":2,"a":"وَرَبُّكَ","e":"and your Lord"},{"p":3,"a":"ٱلْأَكْرَمُ","e":"(is) the Most Generous"}],"96:4":[{"p":1,"a":"ٱلَّذِى","e":"The One Who"},{"p":2,"a":"عَلَّمَ","e":"taught"},{"p":3,"a":"بِٱلْقَلَمِ","e":"by the pen"}],"96:5":[{"p":1,"a":"عَلَّمَ","e":"Taught"},{"p":2,"a":"ٱلْإِنسَـٰنَ","e":"man"},{"p":3,"a":"مَا","e":"what"},{"p":4,"a":"لَمْ","e":"not"},{"p":5,"a":"يَعْلَمْ","e":"he knew"}],"96:6":[{"p":1,"a":"كَلَّآ","e":"Nay"},{"p":2,"a":"إِنَّ","e":"Indeed"},{"p":3,"a":"ٱلْإِنسَـٰنَ","e":"man"},{"p":4,"a":"لَيَطْغَىٰٓ","e":"surely transgresses"}],"96:7":[{"p":1,"a":"أَن","e":"That"},{"p":2,"a":"رَّءَاهُ","e":"he sees himself"},{"p":3,"a":"ٱسْتَغْنَىٰٓ","e":"self-sufficient"}],"96:8":[{"p":1,"a":"إِنَّ","e":"Indeed"},{"p":2,"a":"إِلَىٰ","e":"to"},{"p":3,"a":"رَبِّكَ","e":"your Lord"},{"p":4,"a":"ٱلرُّجْعَىٰٓ","e":"(is) the return"}],"96:9":[{"p":1,"a":"أَرَءَيْتَ","e":"Have you seen"},{"p":2,"a":"ٱلَّذِى","e":"the one who"},{"p":3,"a":"يَنْهَىٰ","e":"forbids"}],"96:10":[{"p":1,"a":"عَبْدًا","e":"A slave"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"صَلَّىٰٓ","e":"he prays"}],"96:11":[{"p":1,"a":"أَرَءَيْتَ","e":"Have you seen"},{"p":2,"a":"إِن","e":"if"},{"p":3,"a":"كَانَ","e":"he is"},{"p":4,"a":"عَلَى","e":"upon"},{"p":5,"a":"ٱلْهُدَىٰٓ","e":"[the] guidance"}],"96:12":[{"p":1,"a":"أَوْ","e":"Or"},{"p":2,"a":"أَمَرَ","e":"he enjoins"},{"p":3,"a":"بِٱلتَّقْوَىٰٓ","e":"[of the] righteousness"}],"96:13":[{"p":1,"a":"أَرَءَيْتَ","e":"Have you seen"},{"p":2,"a":"إِن","e":"if"},{"p":3,"a":"كَذَّبَ","e":"he denies"},{"p":4,"a":"وَتَوَلَّىٰٓ","e":"and turns away"}],"96:14":[{"p":1,"a":"أَلَمْ","e":"Does not"},{"p":2,"a":"يَعْلَم","e":"he know"},{"p":3,"a":"بِأَنَّ","e":"that"},{"p":4,"a":"ٱللَّهَ","e":"Allah"},{"p":5,"a":"يَرَىٰ","e":"sees"}],"96:15":[{"p":1,"a":"كَلَّا","e":"Nay"},{"p":2,"a":"لَئِن","e":"If"},{"p":3,"a":"لَّمْ","e":"not"},{"p":4,"a":"يَنتَهِ","e":"he desists"},{"p":5,"a":"لَنَسْفَعًۢا","e":"surely We will drag him"},{"p":6,"a":"بِٱلنَّاصِيَةِ","e":"by the forelock"}],"96:16":[{"p":1,"a":"نَاصِيَةٍۢ","e":"A forelock"},{"p":2,"a":"كَـٰذِبَةٍ","e":"lying"},{"p":3,"a":"خَاطِئَةٍۢ","e":"sinful"}],"96:17":[{"p":1,"a":"فَلْيَدْعُ","e":"Then let him call"},{"p":2,"a":"نَادِيَهُۥ","e":"his associates"}],"96:18":[{"p":1,"a":"سَنَدْعُ","e":"We will call"},{"p":2,"a":"ٱلزَّبَانِيَةَ","e":"the Angels of Hell"}],"96:19":[{"p":1,"a":"كَلَّا","e":"Nay"},{"p":2,"a":"لَا","e":"(Do) not"},{"p":3,"a":"تُطِعْهُ","e":"obey him"},{"p":4,"a":"وَٱسْجُدْ","e":"But prostrate"},{"p":5,"a":"وَٱقْتَرِب ۩","e":"and draw near (to Allah)"}]}