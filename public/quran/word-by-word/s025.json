ining"}],"25:62":[{"p":1,"a":"وَهُوَ","e":"And He"},{"p":2,"a":"ٱلَّذِى","e":"(is) the One Who"},{"p":3,"a":"جَعَلَ","e":"made"},{"p":4,"a":"ٱلَّيْلَ","e":"the night"},{"p":5,"a":"وَٱلنَّهَارَ","e":"and the day"},{"p":6,"a":"خِلْفَةًۭ","e":"(in) succession"},{"p":7,"a":"لِّمَنْ","e":"for whoever"},{"p":8,"a":"أَرَادَ","e":"desires"},{"p":9,"a":"أَن","e":"to"},{"p":10,"a":"يَذَّكَّرَ","e":"remember"},{"p":11,"a":"أَوْ","e":"or"},{"p":12,"a":"أَرَادَ","e":"desires"},{"p":13,"a":"شُكُورًۭا","e":"to be thankful"}],"25:63":[{"p":1,"a":"وَعِبَادُ","e":"And (the) slaves"},{"p":2,"a":"ٱلرَّحْمَـٰنِ","e":"(of) the Most Gracious"},{"p":3,"a":"ٱلَّذِينَ","e":"(are) those who"},{"p":4,"a":"يَمْشُونَ","e":"walk"},{"p":5,"a":"عَلَى","e":"on"},{"p":6,"a":"ٱلْأَرْضِ","e":"the earth"},{"p":7,"a":"هَوْنًۭا","e":"(in) humbleness"},{"p":8,"a":"وَإِذَا","e":"and when"},{"p":9,"a":"خَاطَبَهُمُ","e":"address them"},{"p":10,"a":"ٱلْجَـٰهِلُونَ","e":"the ignorant ones"},{"p":11,"a":"قَالُواْ","e":"they say"},{"p":12,"a":"سَلَـٰمًۭا","e":"Peace"}],"25:64":[{"p":1,"a":"وَٱلَّذِينَ","e":"And those who"},{"p":2,"a":"يَبِيتُونَ","e":"spend (the) night"},{"p":3,"a":"لِرَبِّهِمْ","e":"before their Lord"},{"p":4,"a":"سُجَّدًۭا","e":"prostrating"},{"p":5,"a":"وَقِيَـٰمًۭا","e":"and standing"}],"25:65":[{"p":1,"a":"وَٱلَّذِينَ","e":"And those who"},{"p":2,"a":"يَقُولُونَ","e":"say"},{"p":3,"a":"رَبَّنَا","e":"Our Lord"},{"p":4,"a":"ٱصْرِفْ","e":"Avert"},{"p":5,"a":"عَنَّا","e":"from us"},{"p":6,"a":"عَذَابَ","e":"the punishment"},{"p":7,"a":"جَهَنَّمَ ۖ","e":"(of) Hell"},{"p":8,"a":"إِنَّ","e":"Indeed"},{"p":9,"a":"عَذَابَهَا","e":"its punishment"},{"p":10,"a":"كَانَ","e":"is"},{"p":11,"a":"غَرَامًا","e":"inseparable"}],"25:66":[{"p":1,"a":"إِنَّهَا","e":"Indeed, it"},{"p":2,"a":"سَآءَتْ","e":"(is) an evil"},{"p":3,"a":"مُسْتَقَرًّۭا","e":"abode"},{"p":4,"a":"وَمُقَامًۭا","e":"and resting place"}],"25:67":[{"p":1,"a":"وَٱلَّذِينَ","e":"And those who"},{"p":2,"a":"إِذَآ","e":"when"},{"p":3,"a":"أَنف