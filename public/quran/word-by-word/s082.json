{"82:1":[{"p":1,"a":"إِذَا","e":"When"},{"p":2,"a":"ٱلسَّمَآءُ","e":"the sky"},{"p":3,"a":"ٱنفَطَرَتْ","e":"(is) cleft asunder"}],"82:2":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْكَوَاكِبُ","e":"the stars"},{"p":3,"a":"ٱنتَثَرَتْ","e":"scatter"}],"82:3":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْبِحَارُ","e":"the seas"},{"p":3,"a":"فُجِّرَتْ","e":"are made to gush forth"}],"82:4":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْقُبُورُ","e":"the graves"},{"p":3,"a":"بُعْثِرَتْ","e":"are overturned"}],"82:5":[{"p":1,"a":"عَلِمَتْ","e":"Will know"},{"p":2,"a":"نَفْسٌۭ","e":"a soul"},{"p":3,"a":"مَّا","e":"what"},{"p":4,"a":"قَدَّمَتْ","e":"it has sent forth"},{"p":5,"a":"وَأَخَّرَتْ","e":"and left behind"}],"82:6":[{"p":1,"a":"يَـٰٓأَيُّهَا","e":"O"},{"p":2,"a":"ٱلْإِنسَـٰنُ","e":"man"},{"p":3,"a":"مَا","e":"What"},{"p":4,"a":"غَرَّكَ","e":"has deceived you"},{"p":5,"a":"بِرَبِّكَ","e":"concerning your Lord"},{"p":6,"a":"ٱلْكَرِيمِ","e":"the Most Noble"}],"82:7":[{"p":1,"a":"ٱلَّذِى","e":"Who"},{"p":2,"a":"خَلَقَكَ","e":"created you"},{"p":3,"a":"فَسَوَّىٰكَ","e":"then fashioned you"},{"p":4,"a":"فَعَدَلَكَ","e":"then balanced you"}],"82:8":[{"p":1,"a":"فِىٓ","e":"In"},{"p":2,"a":"أَىِّ","e":"whatever"},{"p":3,"a":"صُورَةٍۢ","e":"form"},{"p":4,"a":"مَّا","e":"what"},{"p":5,"a":"شَآءَ","e":"He willed"},{"p":6,"a":"رَكَّبَكَ","e":"He assembled you"}],"82:9":[{"p":1,"a":"كَلَّا","e":"Nay"},{"p":2,"a":"بَلْ","e":"But"},{"p":3,"a":"تُكَذِّبُونَ","e":"you deny"},{"p":4,"a":"بِٱلدِّينِ","e":"the Judgment"}],"82:10":[{"p":1,"a":"وَإِنَّ","e":"And indeed"},{"p":2,"a":"عَلَيْكُمْ","e":"over you"},{"p":3,"a":"لَحَـٰفِظِينَ","e":"(are) surely guardians"}],"82:11":[{"p":1,"a":"كِرَامًۭا","e":"Noble"},{"p":2,"a":"كَـٰتِبِينَ","e":"recording"}],"82:12":[{"p":1,"a":"يَعْلَمُونَ","e":"They know"},{"p":2,"a":"مَا","e":"whatever"},{"p":3,"a":"تَفْعَلُونَ","e":"you do"}],"82:13":[{"p":1,"a":"إِنَّ","e":"Indeed"},{"p":2,"a":"ٱلْأَبْرَارَ","e":"the righteous"},{"p":3,"a":"لَفِى","e":"(will be) surely in"},{"p":4,"a":"نَعِيمٍۢ","e":"bliss"}],"82:14":[{"p":1,"a":"وَإِنَّ","e":"And indeed"},{"p":2,"a":"ٱلْفُجَّارَ","e":"the wicked"},{"p":3,"a":"لَفِى","e":"(will be) surely in"},{"p":4,"a":"جَحِيمٍۢ","e":"Hellfire"}],"82:15":[{"p":1,"a":"يَصْلَوْنَهَا","e":"They will burn (in) it"},{"p":2,"a":"يَوْمَ","e":"(on the) Day"},{"p":3,"a":"ٱلدِّينِ","e":"(of) the Judgment"}],"82:16":[{"p":1,"a":"وَمَا","e":"And not"},{"p":2,"a":"هُمْ","e":"they"},{"p":3,"a":"عَنْهَا","e":"from it"},{"p":4,"a":"بِغَآئِبِينَ","e":"(will be) absent"}],"82:17":[{"p":1,"a":"وَمَآ","e":"And what"},{"p":2,"a":"أَدْرَىٰكَ","e":"can make you know"},{"p":3,"a":"مَا","e":"what"},{"p":4,"a":"يَوْمُ","e":"(is the) Day"},{"p":5,"a":"ٱلدِّينِ","e":"(of) the Judgment"}],"82:18":[{"p":1,"a":"ثُمَّ","e":"Then"},{"p":2,"a":"مَآ","e":"what"},{"p":3,"a":"أَدْرَىٰكَ","e":"can make you know"},{"p":4,"a":"مَا","e":"what"},{"p":5,"a":"يَوْمُ","e":"(is the) Day"},{"p":6,"a":"ٱلدِّينِ","e":"(of) the Judgment"}],"82:19":[{"p":1,"a":"يَوْمَ","e":"(The) Day"},{"p":2,"a":"لَا","e":"not"},{"p":3,"a":"تَمْلِكُ","e":"will have power"},{"p":4,"a":"نَفْسٌۭ","e":"a soul"},{"p":5,"a":"لِّنَفْسٍۢ","e":"for a soul"},{"p":6,"a":"شَيْـًۭٔا ۖ","e":"anything"},{"p":7,"a":"وَٱلْأَمْرُ","e":"and the Command"},{"p":8,"a":"يَوْمَئِذٍۢ","e":"that Day"},{"p":9,"a":"لِّلَّهِ","e":"(will be) with Allah"}]}