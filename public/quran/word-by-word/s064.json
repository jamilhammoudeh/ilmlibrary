18":[{"p":1,"a":"عَـٰلِمُ","e":"(The) Knower"},{"p":2,"a":"ٱلْغَيْبِ","e":"(of) the unseen"},{"p":3,"a":"وَٱلشَّهَـٰدَةِ","e":"and the witnessed"},{"p":4,"a":"ٱلْعَزِيزُ","e":"the All-Mighty"},{"p":5,"a":"ٱلْحَكِيمُ","e":"the All-Wise"}]}