{"63:1":[{"p":1,"a":"إِذَا","e":"When"},{"p":2,"a":"جَآءَكَ","e":"come to you"},{"p":3,"a":"ٱلْمُنَـٰفِقُونَ","e":"the hypocrites"},{"p":4,"a":"قَالُواْ","e":"they say"},{"p":5,"a":"نَشْهَدُ","e":"We testify"},{"p":6,"a":"إِنَّكَ","e":"that you"},{"p":7,"a":"لَرَسُولُ","e":"(are) surely (the) Messenger"},{"p":8,"a":"ٱللَّهِ ۗ","e":"(of) Allah"},{"p":9,"a":"وَٱللَّهُ","e":"And Allah"},{"p":10,"a":"يَعْلَمُ","e":"knows"},{"p":11,"a":"إِنَّكَ","e":"that you"},{"p":12,"a":"لَرَسُولُهُۥ","e":"(are) surely His Messenger"},{"p":13,"a":"وَٱللَّهُ","e":"and Allah"},{"p":14,"a":"يَشْهَدُ","e":"testifies"},{"p":15,"a":"إِنَّ","e":"that"},{"p":16,"a":"ٱلْمُنَـٰفِقِينَ","e":"the hypocrites"},{"p":17,"a":"لَكَـٰذِبُونَ","e":"(are) surely liars"}],"63:2":[{"p":1,"a":"ٱتَّخَذُوٓاْ","e":"They take"},{"p":2,"a":"أَيْمَـٰنَهُمْ","e":"their oaths"},{"p":3,"a":"جُنَّةًۭ","e":"(as) a cover"},{"p":4,"a":"فَصَدُّواْ","e":"so they turn away"},{"p":5,"a":"عَن","e":"from"},{"p":6,"a":"سَبِيلِ","e":"(the) Way"},{"p":7,"a":"ٱللَّهِ ۚ","e":"(of) Allah"},{"p":8,"a":"إِنَّهُمْ","e":"Indeed, [they]"},{"p":9,"a":"سَآءَ","e":"evil is"},{"p":10,"a":"مَا","e":"what"},{"p":11,"a":"كَانُواْ","e":"they used to"},{"p":12,"a":"يَعْمَلُونَ","e":"do"}],"63:3":[{"p":1,"a":"ذَٰلِكَ","e":"That"},{"p":2,"a":"بِأَنَّهُمْ","e":"(is) because"},{"p":3,"a":"ءَامَنُواْ","e":"they believed"},{"p":4,"a":"ثُمَّ","e":"then"},{"p":5,"a":"كَفَرُواْ","e":"they disbelieved"},{"p":6,"a":"فَطُبِعَ","e":"so were sealed"},{"p":7,"a":"عَلَىٰ","e":"[upon]"},{"p":8,"a":"قُلُوبِهِمْ","e":"their hearts"},{"p":9,"a":"فَهُمْ","e":"so they"},{"p":10,"a":"لَا","e":"(do) not"},{"p":11,"a":"يَفْقَهُونَ","e":"understand"}],"63:4":[{"p":1,"a":"۞ وَإِذَا","e":"And when"},{"p":2,"a":"رَأَيْتَهُمْ","e":"you see them"},{"p":3,"a":"تُعْجِبُكَ","e":"pleases you"},{"p":4,"a":"أَجْسَامُهُمْ ۖ","e":"their bodies"},{"p":5,"a":"وَإِن","e":"and if"},{"p":6,"a":"يَقُولُواْ","e":"they speak"},{"p":7,"a":"تَسْمَعْ","e":"you listen"},{"p":8,"a":"لِقَوْلِهِمْ ۖ","e":"to their speech"},{"p":9,"a":"كَأَنَّهُمْ","e":"as if they (were)"},{"p":10,"a":"خُشُبٌۭ","e":"pieces of wood"},{"p":11,"a":"مُّسَنَّدَةٌۭ ۖ","e":"propped up"},{"p":12,"a":"يَحْسَبُونَ","e":"They think"},{"p":13,"a":"كُلَّ","e":"every"},{"p":14,"a":"صَيْحَةٍ","e":"shout"},{"p":15,"a":"عَلَيْهِمْ ۚ","e":"(is) against them"},{"p":16,"a":"هُمُ","e":"They"},{"p":17,"a":"ٱلْعَدُوُّ","e":"(are) the enemy"},{"p":18,"a":"فَٱحْذَرْهُمْ ۚ","e":"so beware of them"},{"p":19,"a":"قَـٰتَلَهُمُ","e":"May destroy them"},{"p":20,"a":"ٱللَّهُ ۖ","e":"Allah"},{"p":21,"a":"أَنَّىٰ","e":"How"},{"p":22,"a":"يُؤْفَكُونَ","e":"are they deluded"}],"63:5":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"قِيلَ","e":"it is said"},{"p":3,"a":"لَهُمْ","e":"to them"},{"p":4,"a":"تَعَالَوْاْ","e":"Come"},{"p":5,"a":"يَسْتَغْفِرْ","e":"will ask forgiveness"},{"p":6,"a":"لَكُمْ","e":"for you"},{"p":7,"a":"رَسُولُ","e":"(the) Messenger"},{"p":8,"a":"ٱللَّهِ","e":"(of) Allah"},{"p":9,"a":"لَوَّوْاْ","e":"They turn aside"},{"p":10,"a":"رُءُوسَهُمْ","e":"their heads"},{"p":11,"a":"وَرَأَيْتَهُمْ","e":"and you see them"},{"p":12,"a":"يَصُدُّونَ","e":"turning away"},{"p":13,"a":"وَهُم","e":"while they"},{"p":14,"a":"مُّسْتَكْبِرُونَ","e":"(are) arrogant"}],"63:6":[{"p":1,"a":"سَوَآءٌ","e":"(It) is same"},{"p":2,"a":"عَلَيْهِمْ","e":"for them"},{"p":3,"a":"أَسْتَغْفَرْتَ","e":"whether you ask forgiveness"},{"p":4,"a":"لَهُمْ","e":"for them"},{"p":5,"a":"أَمْ","e":"or"},{"p":6,"a":"لَمْ","e":"(do) not"},{"p":7,"a":"تَسْتَغْفِرْ","e":"ask forgiveness"},{"p":8,"a":"لَهُمْ","e":"for them"},{"p":9,"a":"لَن","e":"Never"},{"p":10,"a":"يَغْفِرَ","e":"will forgive"},{"p":11,"a":"ٱللَّهُ","e":"Allah"},{"p":12,"a":"لَهُمْ ۚ","e":"[to] them"},{"p":13,"a":"إِنَّ","e":"Indeed"},{"p":14,"a":"ٱللَّهَ","e":"Allah"},{"p":15,"a":"لَا","e":"(does) not"},{"p":16,"a":"يَهْدِى","e":"guide"},{"p":17,"a":"ٱلْقَوْمَ","e":"the people"},{"p":18,"a":"ٱلْفَـٰسِقِينَ","e":"the defiantly disobedient"}],"63:7":[{"p":1,"a":"هُمُ","e":"They"},{"p":2,"a":"ٱلَّذِينَ","e":"(are) those who"},{"p":3,"a":"يَقُولُونَ","e":"say"},{"p":4,"a":"لَا","e":"(Do) not"},{"p":5,"a":"تُنفِقُواْ","e":"spend"},{"p":6,"a":"عَلَىٰ","e":"on"},{"p":7,"a":"مَنْ","e":"(those) who"},{"p":8,"a":"عِندَ","e":"(are) with"},{"p":9,"a":"رَسُولِ","e":"(the) Messenger"},{"p":10,"a":"ٱللَّهِ","e":"(of) Allah"},{"p":11,"a":"حَتَّىٰ","e":"until"},{"p":12,"a":"يَنفَضُّواْ ۗ","e":"they disband"},{"p":13,"a":"وَلِلَّهِ","e":"And for Allah"},{"p":14,"a":"خَزَآئِنُ","e":"(are the) treasures"},{"p":15,"a":"ٱلسَّمَـٰوَٰتِ","e":"(of) the heavens"},{"p":16,"a":"وَٱلْأَرْضِ","e":"and the earth"},{"p":17,"a":"وَلَـٰكِنَّ","e":"but"},{"p":18,"a":"ٱلْمُنَـٰفِقِينَ","e":"the hypocrites"},{"p":19,"a":"لَا","e":"(do) not"},{"p":20,"a":"يَفْقَهُونَ","e":"understand"}],"63:8":[{"p":1,"a":"يَقُولُونَ","e":"They say"},{"p":2,"a":"لَئِن","e":"If"},{"p":3,"a":"رَّجَعْنَآ","e":"we return"},{"p":4,"a":"إِلَى","e":"to"},{"p":5,"a":"ٱلْمَدِينَةِ","e":"Al-Madinah"},{"p":6,"a":"لَيُخْرِجَنَّ","e":"surely, will expel"},{"p":7,"a":"ٱلْأَعَزُّ","e":"the more honorable"},{"p":8,"a":"مِنْهَا","e":"from it"},{"p":9,"a":"ٱلْأَذَلَّ ۚ","e":"the more humble"},{"p":10,"a":"وَلِلَّهِ","e":"But for Allah"},{"p":11,"a":"ٱلْعِزَّةُ","e":"(is) the honor"},{"p":12,"a":"وَلِرَسُولِهِۦ","e":"and for His Messenger"},{"p":13,"a":"وَلِلْمُؤْمِنِينَ","e":"and for the believers"},{"p":14,"a":"وَلَـٰكِنَّ","e":"but"},{"p":15,"a":"ٱلْمُنَـٰفِقِينَ","e":"the hypocrites"},{"p":16,"a":"لَا","e":"(do) not"},{"p":17,"a":"يَعْلَمُونَ","e":"know"}],"63:9":[{"p":1,"a":"يَـٰٓأَيُّهَا","e":"O"},{"p":2,"a":"ٱلَّذِينَ","e":"you (who)"},{"p":3,"a":"ءَامَنُواْ","e":"believe"},{"p":4,"a":"لَا","e":"(Let) not"},{"p":5,"a":"تُلْهِكُمْ","e":"divert you"},{"p":6,"a":"أَمْوَٰلُكُمْ","e":"your wealth"},{"p":7,"a":"وَلَآ","e":"and not"},{"p":8,"a":"أَوْلَـٰدُكُمْ","e":"your children"},{"p":9,"a":"عَن","e":"from"},{"p":10,"a":"ذِكْرِ","e":"(the) remembrance"},{"p":11,"a":"ٱللَّهِ ۚ","e":"(of) Allah"},{"p":12,"a":"وَمَن","e":"And whoever"},{"p":13,"a":"يَفْعَلْ","e":"does"},{"p":14,"a":"ذَٰلِكَ","e":"that"},{"p":15,"a":"فَأُوْلَـٰٓئِكَ","e":"then those"},{"p":16,"a":"هُمُ","e":"[they]"},{"p":17,"a":"ٱلْخَـٰسِرُونَ","e":"(are) the losers"}],"63:10":[{"p":1,"a":"وَأَنفِقُواْ","e":"And spend"},{"p":2,"a":"مِن","e":"from"},{"p":3,"a":"مَّا","e":"what"},{"p":4,"a":"رَزَقْنَـٰكُم","e":"We have provided you"},{"p":5,"a":"مِّن","e":"from"},{"p":6,"a":"قَبْلِ","e":"before"},{"p":7,"a":"أَن","e":"[that]"},{"p":8,"a":"يَأْتِىَ","e":"comes"},{"p":9,"a":"أَحَدَكُمُ","e":"(to) one of you"},{"p":10,"a":"ٱلْمَوْتُ","e":"the death"},{"p":11,"a":"فَيَقُولَ","e":"and he says"},{"p":12,"a":"رَبِّ","e":"My Lord"},{"p":13,"a":"لَوْلَآ","e":"Why not"},{"p":14,"a":"أَخَّرْتَنِىٓ","e":"You delay me"},{"p":15,"a":"إِلَىٰٓ","e":"for"},{"p":16,"a":"أَجَلٍۢ","e":"a term"},{"p":17,"a":"قَرِيبٍۢ","e":"near"},{"p":18,"a":"فَأَصَّدَّقَ","e":"so I would give charity"},{"p":19,"a":"وَأَكُن","e":"and be"},{"p":20,"a":"مِّنَ","e":"among"},{"p":21,"a":"ٱلصَّـٰلِحِينَ","e":"the righteous"}],"63:11":[{"p":1,"a":"وَلَن","e":"But never"},{"p":2,"a":"يُؤَخِّرَ","e":"will (be) delayed"},{"p":3,"a":"ٱللَّهُ","e":"(by) Allah"},{"p":4,"a":"نَفْسًا","e":"a soul"},{"p":5,"a":"إِذَا","e":"when"},{"p":6,"a":"جَآءَ","e":"has come"},{"p":7,"a":"أَجَلُهَا ۚ","e":"its term"},{"p":8,"a":"وَٱللَّهُ","e":"And Allah"},{"p":9,"a":"خَبِيرٌۢ","e":"(is) All-Aware"},{"p":10,"a":"بِمَا","e":"of what"},{"p":11,"a":"تَعْمَلُونَ","e":"you do"}]}