{"110:1":[{"p":1,"a":"إِذَا","e":"When"},{"p":2,"a":"جَآءَ","e":"comes"},{"p":3,"a":"نَصْرُ","e":"(the) Help"},{"p":4,"a":"ٱللَّهِ","e":"(of) Allah"},{"p":5,"a":"وَٱلْفَتْحُ","e":"and the Victory"}],"110:2":[{"p":1,"a":"وَرَأَيْتَ","e":"And you see"},{"p":2,"a":"ٱلنَّاسَ","e":"the people"},{"p":3,"a":"يَدْخُلُونَ","e":"entering"},{"p":4,"a":"فِى","e":"into"},{"p":5,"a":"دِينِ","e":"(the) religion"},{"p":6,"a":"ٱللَّهِ","e":"(of) Allah"},{"p":7,"a":"أَفْوَاجًۭا","e":"(in) multitudes"}],"110:3":[{"p":1,"a":"فَسَبِّحْ","e":"Then glorify"},{"p":2,"a":"بِحَمْدِ","e":"with (the) praises"},{"p":3,"a":"رَبِّكَ","e":"(of) your Lord"},{"p":4,"a":"وَٱسْتَغْفِرْهُ ۚ","e":"and ask His forgiveness"},{"p":5,"a":"إِنَّهُۥ","e":"Indeed, He"},{"p":6,"a":"كَانَ","e":"is"},{"p":7,"a":"تَوَّابًۢا","e":"Oft-Returning"}]}