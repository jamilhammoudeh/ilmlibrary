{"91:1":[{"p":1,"a":"وَٱلشَّمْسِ","e":"By the sun"},{"p":2,"a":"وَضُحَىٰهَا","e":"and its brightness"}],"91:2":[{"p":1,"a":"وَٱلْقَمَرِ","e":"And the moon"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"تَلَىٰهَا","e":"it follows it"}],"91:3":[{"p":1,"a":"وَٱلنَّهَارِ","e":"And the day"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"جَلَّىٰهَا","e":"it displays it"}],"91:4":[{"p":1,"a":"وَٱلَّيْلِ","e":"And the night"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"يَغْشَىٰهَا","e":"it covers it"}],"91:5":[{"p":1,"a":"وَٱلسَّمَآءِ","e":"And the heaven"},{"p":2,"a":"وَمَا","e":"and (He) Who"},{"p":3,"a":"بَنَىٰهَا","e":"constructed it"}],"91:6":[{"p":1,"a":"وَٱلْأَرْضِ","e":"And the earth"},{"p":2,"a":"وَمَا","e":"and by (He) Who"},{"p":3,"a":"طَحَىٰهَا","e":"spread it"}],"91:7":[{"p":1,"a":"وَنَفْسٍۢ","e":"And (the) soul"},{"p":2,"a":"وَمَا","e":"and (He) Who"},{"p":3,"a":"سَوَّىٰهَا","e":"proportioned it"}],"91:8":[{"p":1,"a":"فَأَلْهَمَهَا","e":"And He inspired it"},{"p":2,"a":"فُجُورَهَا","e":"(to distinguish) its wickedness"},{"p":3,"a":"وَتَقْوَىٰهَا","e":"and its righteousness"}],"91:9":[{"p":1,"a":"قَدْ","e":"Indeed"},{"p":2,"a":"أَفْلَحَ","e":"he succeeds"},{"p":3,"a":"مَن","e":"who"},{"p":4,"a":"زَكَّىٰهَا","e":"purifies it"}],"91:10":[{"p":1,"a":"وَقَدْ","e":"And indeed"},{"p":2,"a":"خَابَ","e":"he fails"},{"p":3,"a":"مَن","e":"who"},{"p":4,"a":"دَسَّىٰهَا","e":"buries it"}],"91:11":[{"p":1,"a":"كَذَّبَتْ","e":"Denied"},{"p":2,"a":"ثَمُودُ","e":"Thamud"},{"p":3,"a":"بِطَغْوَىٰهَآ","e":"by their transgression"}],"91:12":[{"p":1,"a":"إِذِ","e":"When"},{"p":2,"a":"ٱنۢبَعَثَ","e":"(was) sent forth"},{"p":3,"a":"أَشْقَىٰهَا","e":"(the) most wicked of them"}],"91:13":[{"p":1,"a":"فَقَالَ","e":"But said"},{"p":2,"a":"لَهُمْ","e":"to them"},{"p":3,"a":"رَسُولُ","e":"(the) Messenger"},{"p":4,"a":"ٱللَّهِ","e":"(of) Allah"},{"p":5,"a":"نَاقَةَ","e":"(It is the) she-camel"},{"p":6,"a":"ٱللَّهِ","e":"(of) Allah"},{"p":7,"a":"وَسُقْيَـٰهَا","e":"and her drink"}],"91:14":[{"p":1,"a":"فَكَذَّبُوهُ","e":"But they denied him"},{"p":2,"a":"فَعَقَرُوهَا","e":"and they hamstrung her"},{"p":3,"a":"فَدَمْدَمَ","e":"So destroyed"},{"p":4,"a":"عَلَيْهِمْ","e":"them"},{"p":5,"a":"رَبُّهُم","e":"their Lord"},{"p":6,"a":"بِذَنۢبِهِمْ","e":"for their sin"},{"p":7,"a":"فَسَوَّىٰهَا","e":"and leveled them"}],"91:15":[{"p":1,"a":"وَلَا","e":"And not"},{"p":2,"a":"يَخَافُ","e":"He fears"},{"p":3,"a":"عُقْبَـٰهَا","e":"its consequences"}]}