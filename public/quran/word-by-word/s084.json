{"84:1":[{"p":1,"a":"إِذَا","e":"When"},{"p":2,"a":"ٱلسَّمَآءُ","e":"the sky"},{"p":3,"a":"ٱنشَقَّتْ","e":"is split asunder"}],"84:2":[{"p":1,"a":"وَأَذِنَتْ","e":"And has listened"},{"p":2,"a":"لِرَبِّهَا","e":"to its Lord"},{"p":3,"a":"وَحُقَّتْ","e":"and was obligated"}],"84:3":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْأَرْضُ","e":"the earth"},{"p":3,"a":"مُدَّتْ","e":"is spread"}],"84:4":[{"p":1,"a":"وَأَلْقَتْ","e":"And has cast out"},{"p":2,"a":"مَا","e":"what"},{"p":3,"a":"فِيهَا","e":"(is) in it"},{"p":4,"a":"وَتَخَلَّتْ","e":"and becomes empty"}],"84:5":[{"p":1,"a":"وَأَذِنَتْ","e":"And has listened"},{"p":2,"a":"لِرَبِّهَا","e":"to its Lord"},{"p":3,"a":"وَحُقَّتْ","e":"and was obligated"}],"84:6":[{"p":1,"a":"يَـٰٓأَيُّهَا","e":"O"},{"p":2,"a":"ٱلْإِنسَـٰنُ","e":"mankind"},{"p":3,"a":"إِنَّكَ","e":"Indeed, you"},{"p":4,"a":"كَادِحٌ","e":"(are) laboring"},{"p":5,"a":"إِلَىٰ","e":"to"},{"p":6,"a":"رَبِّكَ","e":"your Lord"},{"p":7,"a":"كَدْحًۭا","e":"(with) exertion"},{"p":8,"a":"فَمُلَـٰقِيهِ","e":"and you (will) meet Him"}],"84:7":[{"p":1,"a":"فَأَمَّا","e":"Then as for"},{"p":2,"a":"مَنْ","e":"(him) who"},{"p":3,"a":"أُوتِىَ","e":"is given"},{"p":4,"a":"كِتَـٰبَهُۥ","e":"his record"},{"p":5,"a":"بِيَمِينِهِۦ","e":"in his right (hand)"}],"84:8":[{"p":1,"a":"فَسَوْفَ","e":"Then soon"},{"p":2,"a":"يُحَاسَبُ","e":"his account will be taken"},{"p":3,"a":"حِسَابًۭا","e":"an account"},{"p":4,"a":"يَسِيرًۭا","e":"easy"}],"84:9":[{"p":1,"a":"وَيَنقَلِبُ","e":"And he will return"},{"p":2,"a":"إِلَىٰٓ","e":"to"},{"p":3,"a":"أَهْلِهِۦ","e":"his people"},{"p":4,"a":"مَسْرُورًۭا","e":"happily"}],"84:10":[{"p":1,"a":"وَأَمَّا","e":"But as for"},{"p":2,"a":"مَنْ","e":"(him) who"},{"p":3,"a":"أُوتِىَ","e":"is given"},{"p":4,"a":"كِتَـٰبَهُۥ","e":"his record"},{"p":5,"a":"وَرَآءَ","e":"behind"},{"p":6,"a":"ظَهْرِهِۦ","e":"his back"}],"84:11":[{"p":1,"a":"فَسَوْفَ","e":"Then soon"},{"p":2,"a":"يَدْعُواْ","e":"he will call"},{"p":3,"a":"ثُبُورًۭا","e":"(for) destruction"}],"84:12":[{"p":1,"a":"وَيَصْلَىٰ","e":"And he will burn"},{"p":2,"a":"سَعِيرًا","e":"(in) a Blaze"}],"84:13":[{"p":1,"a":"إِنَّهُۥ","e":"Indeed, he"},{"p":2,"a":"كَانَ","e":"had been"},{"p":3,"a":"فِىٓ","e":"among"},{"p":4,"a":"أَهْلِهِۦ","e":"his people"},{"p":5,"a":"مَسْرُورًا","e":"happy"}],"84:14":[{"p":1,"a":"إِنَّهُۥ","e":"Indeed, he"},{"p":2,"a":"ظَنَّ","e":"(had) thought"},{"p":3,"a":"أَن","e":"that"},{"p":4,"a":"لَّن","e":"never"},{"p":5,"a":"يَحُورَ","e":"he would return"}],"84:15":[{"p":1,"a":"بَلَىٰٓ","e":"Yes"},{"p":2,"a":"إِنَّ","e":"Indeed"},{"p":3,"a":"رَبَّهُۥ","e":"his Lord"},{"p":4,"a":"كَانَ","e":"was"},{"p":5,"a":"بِهِۦ","e":"of him"},{"p":6,"a":"بَصِيرًۭا","e":"All-Seer"}],"84:16":[{"p":1,"a":"فَلَآ","e":"But nay"},{"p":2,"a":"أُقْسِمُ","e":"I swear"},{"p":3,"a":"بِٱلشَّفَقِ","e":"by the twilight glow"}],"84:17":[{"p":1,"a":"وَٱلَّيْلِ","e":"And the night"},{"p":2,"a":"وَمَا","e":"and what"},{"p":3,"a":"وَسَقَ","e":"it envelops"}],"84:18":[{"p":1,"a":"وَٱلْقَمَرِ","e":"And the moon"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"ٱتَّسَقَ","e":"it becomes full"}],"84:19":[{"p":1,"a":"لَتَرْكَبُنَّ","e":"You will surely embark"},{"p":2,"a":"طَبَقًا","e":"(to) stage"},{"p":3,"a":"عَن","e":"from"},{"p":4,"a":"طَبَقٍۢ","e":"stage"}],"84:20":[{"p":1,"a":"فَمَا","e":"So what"},{"p":2,"a":"لَهُمْ","e":"(is) for them"},{"p":3,"a":"لَا","e":"not"},{"p":4,"a":"يُؤْمِنُونَ","e":"they believe"}],"84:21":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"قُرِئَ","e":"is recited"},{"p":3,"a":"عَلَيْهِمُ","e":"to them"},{"p":4,"a":"ٱلْقُرْءَانُ","e":"the Quran"},{"p":5,"a":"لَا","e":"not"},{"p":6,"a":"يَسْجُدُونَ ۩","e":"they prostrate"}],"84:22":[{"p":1,"a":"بَلِ","e":"Nay"},{"p":2,"a":"ٱلَّذِينَ","e":"Those who"},{"p":3,"a":"كَفَرُواْ","e":"disbelieved"},{"p":4,"a":"يُكَذِّبُونَ","e":"deny"}],"84:23":[{"p":1,"a":"وَٱللَّهُ","e":"And Allah"},{"p":2,"a":"أَعْلَمُ","e":"(is) most knowing"},{"p":3,"a":"بِمَا","e":"of what"},{"p":4,"a":"يُوعُونَ","e":"they keep within themselves"}],"84:24":[{"p":1,"a":"فَبَشِّرْهُم","e":"so give them tidings"},{"p":2,"a":"بِعَذَابٍ","e":"of a punishment"},{"p":3,"a":"أَلِيمٍ","e":"painful"}],"84:25":[{"p":1,"a":"إِلَّا","e":"Except"},{"p":2,"a":"ٱلَّذِينَ","e":"those who"},{"p":3,"a":"ءَامَنُواْ","e":"believe"},{"p":4,"a":"وَعَمِلُواْ","e":"and do"},{"p":5,"a":"ٱلصَّـٰلِحَـٰتِ","e":"righteous deeds"},{"p":6,"a":"لَهُمْ","e":"For them"},{"p":7,"a":"أَجْرٌ","e":"(is) a reward"},{"p":8,"a":"غَيْرُ","e":"never"},{"p":9,"a":"مَمْنُونٍۭ","e":"ending"}]}