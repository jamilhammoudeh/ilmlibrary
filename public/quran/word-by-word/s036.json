{"36:1":[{"p":1,"a":"يسٓ","e":"Ya Seen"}],"36:2":[{"p":1,"a":"وَٱلْقُرْءَانِ","e":"By the Quran"},{"p":2,"a":"ٱلْحَكِيمِ","e":"the Wise"}],"36:3":[{"p":1,"a":"إِنَّكَ","e":"Indeed, you"},{"p":2,"a":"لَمِنَ","e":"(are) among"},{"p":3,"a":"ٱلْمُرْسَلِينَ","e":"the Messengers"}],"36:4":[{"p":1,"a":"عَلَىٰ","e":"On"},{"p":2,"a":"صِرَٰطٍۢ","e":"a Path"},{"p":3,"a":"مُّسْتَقِيمٍۢ","e":"Straight"}],"36:5":[{"p":1,"a":"تَنزِيلَ","e":"A revelation"},{"p":2,"a":"ٱلْعَزِيزِ","e":"(of) the All-Mighty"},{"p":3,"a":"ٱلرَّحِيمِ","e":"the Most Merciful"}],"36:6":[{"p":1,"a":"لِتُنذِرَ","e":"That you may warn"},{"p":2,"a":"قَوْمًۭا","e":"a people"},{"p":3,"a":"مَّآ","e":"not"},{"p":4,"a":"أُنذِرَ","e":"were warned"},{"p":5,"a":"ءَابَآؤُهُمْ","e":"their forefathers"},{"p":6,"a":"فَهُمْ","e":"so they"},{"p":7,"a":"غَـٰفِلُونَ","e":"(are) heedless"}],"36:7":[{"p":1,"a":"لَقَدْ","e":"Certainly"},{"p":2,"a":"حَقَّ","e":"(has) proved true"},{"p":3,"a":"ٱلْقَوْلُ","e":"the word"},{"p":4,"a":"عَلَىٰٓ","e":"upon"},{"p":5,"a":"أَكْثَرِهِمْ","e":"most of them"},{"p":6,"a":"فَهُمْ","e":"so they"},{"p":7,"a":"لَا","e":"(do) not"},{"p":8,"a":"يُؤْمِنُونَ","e":"believe"}],"36:8":[{"p":1,"a":"إِنَّا","e":"Indeed, We"},{"p":2,"a":"جَعَلْنَا","e":"[We] have placed"},{"p":3,"a":"فِىٓ","e":"on"},{"p":4,"a":"أَعْنَـٰقِهِمْ","e":"their necks"},{"p":5,"a":"أَغْلَـٰلًۭا","e":"iron collars"},{"p":6,"a":"فَهِىَ","e":"and they"},{"p":7,"a":"إِلَى","e":"(are up) to"},{"p":8,"a":"ٱلْأَذْقَانِ","e":"the chins"},{"p":9,"a":"فَهُم","e":"so they"},{"p":10,"a":"مُّقْمَحُونَ","e":"(are with) heads raised up"}],"36:9":[{"p":1,"a":"وَجَعَلْنَا","e":"And We have made"},{"p":2,"a":"مِنۢ","e":"from"},{"p":3,"a":"بَيْنِ","e":"before/between"},{"p":4,"a":"أَيْدِيهِمْ","e":"their hands/their front"},{"p":5,"a":"سَدًّۭا","e":"a barrier"},{"p":6,"a":"وَمِنْ","e":"and from"},{"p":7,"a":"خَلْفِهِمْ","e":"behind them"},{"p":8,"a":"سَدًّۭا","e":"a barrier"},{"p":9,"a":"فَأَغْشَيْنَـٰهُمْ","e":"and We covered them"},{"p":10,"a":"