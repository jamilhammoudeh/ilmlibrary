{"105:1":[{"p":1,"a":"أَلَمْ","e":"Have not"},{"p":2,"a":"تَرَ","e":"you seen"},{"p":3,"a":"كَيْفَ","e":"how"},{"p":4,"a":"فَعَلَ","e":"dealt"},{"p":5,"a":"رَبُّكَ","e":"your Lord"},{"p":6,"a":"بِأَصْحَـٰبِ","e":"with (the) Companions"},{"p":7,"a":"ٱلْفِيلِ","e":"(of the) Elephant"}],"105:2":[{"p":1,"a":"أَلَمْ","e":"Did not"},{"p":2,"a":"يَجْعَلْ","e":"He make"},{"p":3,"a":"كَيْدَهُمْ","e":"their plan"},{"p":4,"a":"فِى","e":"go"},{"p":5,"a":"تَضْلِيلٍۢ","e":"astray"}],"105:3":[{"p":1,"a":"وَأَرْسَلَ","e":"And He sent"},{"p":2,"a":"عَلَيْهِمْ","e":"against them"},{"p":3,"a":"طَيْرًا","e":"birds"},{"p":4,"a":"أَبَابِيلَ","e":"(in) flocks"}],"105:4":[{"p":1,"a":"تَرْمِيهِم","e":"Striking them"},{"p":2,"a":"بِحِجَارَةٍۢ","e":"with stones"},{"p":3,"a":"مِّن","e":"of"},{"p":4,"a":"سِجِّيلٍۢ","e":"baked clay"}],"105:5":[{"p":1,"a":"فَجَعَلَهُمْ","e":"Then He made them"},{"p":2,"a":"كَعَصْفٍۢ","e":"like straw"},{"p":3,"a":"مَّأْكُولٍۭ","e":"eaten up"}]}