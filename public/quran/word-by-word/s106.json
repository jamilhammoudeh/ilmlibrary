{"106:1":[{"p":1,"a":"لِإِيلَـٰفِ","e":"For (the) familiarity"},{"p":2,"a":"قُرَيْشٍ","e":"(of the) Quraish"}],"106:2":[{"p":1,"a":"إِۦلَـٰفِهِمْ","e":"Their familiarity"},{"p":2,"a":"رِحْلَةَ","e":"(with the) journey"},{"p":3,"a":"ٱلشِّتَآءِ","e":"(of) winter"},{"p":4,"a":"وَٱلصَّيْفِ","e":"and summer"}],"106:3":[{"p":1,"a":"فَلْيَعْبُدُواْ","e":"So let them worship"},{"p":2,"a":"رَبَّ","e":"(the) Lord"},{"p":3,"a":"هَـٰذَا","e":"(of) this"},{"p":4,"a":"ٱلْبَيْتِ","e":"House"}],"106:4":[{"p":1,"a":"ٱلَّذِىٓ","e":"The One Who"},{"p":2,"a":"أَطْعَمَهُم","e":"feeds them"},{"p":3,"a":"مِّن","e":"[from]"},{"p":4,"a":"جُوعٍۢ","e":"(against) hunger"},{"p":5,"a":"وَءَامَنَهُم","e":"and gives them security"},{"p":6,"a":"مِّنْ","e":"from"},{"p":7,"a":"خَوْفٍۭ","e":"fear"}]}