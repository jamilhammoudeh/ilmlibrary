{"99:1":[{"p":1,"a":"إِذَا","e":"When"},{"p":2,"a":"زُلْزِلَتِ","e":"is shaken"},{"p":3,"a":"ٱلْأَرْضُ","e":"the earth"},{"p":4,"a":"زِلْزَالَهَا","e":"(with) its earthquake"}],"99:2":[{"p":1,"a":"وَأَخْرَجَتِ","e":"And brings forth"},{"p":2,"a":"ٱلْأَرْضُ","e":"the earth"},{"p":3,"a":"أَثْقَالَهَا","e":"its burdens"}],"99:3":[{"p":1,"a":"وَقَالَ","e":"And says"},{"p":2,"a":"ٱلْإِنسَـٰنُ","e":"man"},{"p":3,"a":"مَا","e":"What"},{"p":4,"a":"لَهَا","e":"(is) with it"}],"99:4":[{"p":1,"a":"يَوْمَئِذٍۢ","e":"That Day"},{"p":2,"a":"تُحَدِّثُ","e":"it will report"},{"p":3,"a":"أَخْبَارَهَا","e":"its news"}],"99:5":[{"p":1,"a":"بِأَنَّ","e":"Because"},{"p":2,"a":"رَبَّكَ","e":"your Lord"},{"p":3,"a":"أَوْحَىٰ","e":"inspired"},{"p":4,"a":"لَهَا","e":"[to] it"}],"99:6":[{"p":1,"a":"يَوْمَئِذٍۢ","e":"That Day"},{"p":2,"a":"يَصْدُرُ","e":"will proceed"},{"p":3,"a":"ٱلنَّاسُ","e":"the mankind"},{"p":4,"a":"أَشْتَاتًۭا","e":"(in) scattered groups"},{"p":5,"a":"لِّيُرَوْاْ","e":"to be shown"},{"p":6,"a":"أَعْمَـٰلَهُمْ","e":"their deeds"}],"99:7":[{"p":1,"a":"فَمَن","e":"So whoever"},{"p":2,"a":"يَعْمَلْ","e":"does"},{"p":3,"a":"مِثْقَالَ","e":"(equal to the) weight"},{"p":4,"a":"ذَرَّةٍ","e":"(of) an atom"},{"p":5,"a":"خَيْرًۭا","e":"good"},{"p":6,"a":"يَرَهُۥ","e":"will see it"}],"99:8":[{"p":1,"a":"وَمَن","e":"And whoever"},{"p":2,"a":"يَعْمَلْ","e":"does"},{"p":3,"a":"مِثْقَالَ","e":"(equal to the) weight"},{"p":4,"a":"ذَرَّةٍۢ","e":"(of) an atom"},{"p":5,"a":"شَرًّۭا","e":"evil"},{"p":6,"a":"يَرَهُۥ","e":"will see it"}]}