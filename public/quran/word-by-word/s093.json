{"93:1":[{"p":1,"a":"وَٱلضُّحَىٰ","e":"By the morning brightness"}],"93:2":[{"p":1,"a":"وَٱلَّيْلِ","e":"And the night"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"سَجَىٰ","e":"it covers with darkness"}],"93:3":[{"p":1,"a":"مَا","e":"Not"},{"p":2,"a":"وَدَّعَكَ","e":"has forsaken you"},{"p":3,"a":"رَبُّكَ","e":"your Lord"},{"p":4,"a":"وَمَا","e":"and not"},{"p":5,"a":"قَلَىٰ","e":"He is displeased"}],"93:4":[{"p":1,"a":"وَلَلْـَٔاخِرَةُ","e":"And surely the Hereafter"},{"p":2,"a":"خَيْرٌۭ","e":"(is) better"},{"p":3,"a":"لَّكَ","e":"for you"},{"p":4,"a":"مِنَ","e":"than"},{"p":5,"a":"ٱلْأُولَىٰ","e":"the first"}],"93:5":[{"p":1,"a":"وَلَسَوْفَ","e":"And soon"},{"p":2,"a":"يُعْطِيكَ","e":"will give you"},{"p":3,"a":"رَبُّكَ","e":"your Lord"},{"p":4,"a":"فَتَرْضَىٰٓ","e":"then you will be satisfied"}],"93:6":[{"p":1,"a":"أَلَمْ","e":"Did not"},{"p":2,"a":"يَجِدْكَ","e":"He find you"},{"p":3,"a":"يَتِيمًۭا","e":"an orphan"},{"p":4,"a":"فَـَٔاوَىٰ","e":"and give shelter"}],"93:7":[{"p":1,"a":"وَوَجَدَكَ","e":"And He found you"},{"p":2,"a":"ضَآلًّۭا","e":"lost"},{"p":3,"a":"فَهَدَىٰ","e":"so He guided"}],"93:8":[{"p":1,"a":"وَوَجَدَكَ","e":"And He found you"},{"p":2,"a":"عَآئِلًۭا","e":"in need"},{"p":3,"a":"فَأَغْنَىٰ","e":"so He made self-sufficient"}],"93:9":[{"p":1,"a":"فَأَمَّا","e":"So as for"},{"p":2,"a":"ٱلْيَتِيمَ","e":"the orphan"},{"p":3,"a":"فَلَا","e":"then (do) not"},{"p":4,"a":"تَقْهَرْ","e":"oppress"}],"93:10":[{"p":1,"a":"وَأَمَّا","e":"And as for"},{"p":2,"a":"ٱلسَّآئِلَ","e":"one who asks"},{"p":3,"a":"فَلَا","e":"then (do) not"},{"p":4,"a":"تَنْهَرْ","e":"repel"}],"93:11":[{"p":1,"a":"وَأَمَّا","e":"But as for"},{"p":2,"a":"بِنِعْمَةِ","e":"(the) Favor"},{"p":3,"a":"رَبِّكَ","e":"(of) your Lord"},{"p":4,"a":"فَحَدِّثْ","e":"narrate"}]}