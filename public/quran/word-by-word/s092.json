{"92:1":[{"p":1,"a":"وَٱلَّيْلِ","e":"By the night"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"يَغْشَىٰ","e":"it covers"}],"92:2":[{"p":1,"a":"وَٱلنَّهَارِ","e":"And the day"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"تَجَلَّىٰ","e":"it shines in brightness"}],"92:3":[{"p":1,"a":"وَمَا","e":"And He Who"},{"p":2,"a":"خَلَقَ","e":"created"},{"p":3,"a":"ٱلذَّكَرَ","e":"the male"},{"p":4,"a":"وَٱلْأُنثَىٰٓ","e":"and the female"}],"92:4":[{"p":1,"a":"إِنَّ","e":"Indeed"},{"p":2,"a":"سَعْيَكُمْ","e":"your efforts"},{"p":3,"a":"لَشَتَّىٰ","e":"(are) surely diverse"}],"92:5":[{"p":1,"a":"فَأَمَّا","e":"Then as for"},{"p":2,"a":"مَنْ","e":"(him) who"},{"p":3,"a":"أَعْطَىٰ","e":"gives"},{"p":4,"a":"وَٱتَّقَىٰ","e":"and fears"}],"92:6":[{"p":1,"a":"وَصَدَّقَ","e":"And believes"},{"p":2,"a":"بِٱلْحُسْنَىٰ","e":"in the best"}],"92:7":[{"p":1,"a":"فَسَنُيَسِّرُهُۥ","e":"Then We will ease him"},{"p":2,"a":"لِلْيُسْرَىٰ","e":"towards [the] ease"}],"92:8":[{"p":1,"a":"وَأَمَّا","e":"But as for"},{"p":2,"a":"مَنۢ","e":"(him) who"},{"p":3,"a":"بَخِلَ","e":"withholds"},{"p":4,"a":"وَٱسْتَغْنَىٰ","e":"and considers himself free from need"}],"92:9":[{"p":1,"a":"وَكَذَّبَ","e":"And denies"},{"p":2,"a":"بِٱلْحُسْنَىٰ","e":"the best"}],"92:10":[{"p":1,"a":"فَسَنُيَسِّرُهُۥ","e":"Then We will ease him"},{"p":2,"a":"لِلْعُسْرَىٰ","e":"towards [the] difficulty"}],"92:11":[{"p":1,"a":"وَمَا","e":"And not"},{"p":2,"a":"يُغْنِى","e":"will avail"},{"p":3,"a":"عَنْهُ","e":"him"},{"p":4,"a":"مَالُهُۥٓ","e":"his wealth"},{"p":5,"a":"إِذَا","e":"when"},{"p":6,"a":"تَرَدَّىٰٓ","e":"he falls"}],"92:12":[{"p":1,"a":"إِنَّ","e":"Indeed"},{"p":2,"a":"عَلَيْنَا","e":"upon Us"},{"p":3,"a":"لَلْهُدَىٰ","e":"(is) the guidance"}],"92:13":[{"p":1,"a":"وَإِنَّ","e":"And indeed"},{"p":2,"a":"لَنَا","e":"for Us"},{"p":3,"a":"لَلْـَٔاخِرَةَ","e":"(is) the Hereafter"},{"p":4,"a":"وَٱلْأُولَىٰ","e":"and the first (life)"}],"92:14":[{"p":1,"a":"فَأَنذَرْتُكُمْ","e":"So I warn you"},{"p":2,"a":"نَارًۭا","e":"(of) a Fire"},{"p":3,"a":"تَلَظَّىٰ","e":"blazing"}],"92:15":[{"p":1,"a":"لَا","e":"Not"},{"p":2,"a":"يَصْلَىٰهَآ","e":"will burn (in) it"},{"p":3,"a":"إِلَّا","e":"except"},{"p":4,"a":"ٱلْأَشْقَى","e":"the most wretched"}],"92:16":[{"p":1,"a":"ٱلَّذِى","e":"The one who"},{"p":2,"a":"كَذَّبَ","e":"denied"},{"p":3,"a":"وَتَوَلَّىٰ","e":"and turned away"}],"92:17":[{"p":1,"a":"وَسَيُجَنَّبُهَا","e":"But will be removed from it"},{"p":2,"a":"ٱلْأَتْقَى","e":"the righteous"}],"92:18":[{"p":1,"a":"ٱلَّذِى","e":"The one who"},{"p":2,"a":"يُؤْتِى","e":"gives"},{"p":3,"a":"مَالَهُۥ","e":"his wealth"},{"p":4,"a":"يَتَزَكَّىٰ","e":"(to) purify himself"}],"92:19":[{"p":1,"a":"وَمَا","e":"And not"},{"p":2,"a":"لِأَحَدٍ","e":"for anyone"},{"p":3,"a":"عِندَهُۥ","e":"with him"},{"p":4,"a":"مِن","e":"any"},{"p":5,"a":"نِّعْمَةٍۢ","e":"favor"},{"p":6,"a":"تُجْزَىٰٓ","e":"to be recompensed"}],"92:20":[{"p":1,"a":"إِلَّا","e":"Except"},{"p":2,"a":"ٱبْتِغَآءَ","e":"seeking"},{"p":3,"a":"وَجْهِ","e":"(the) Countenance"},{"p":4,"a":"رَبِّهِ","e":"(of) his Lord"},{"p":5,"a":"ٱلْأَعْلَىٰ","e":"the Most High"}],"92:21":[{"p":1,"a":"وَلَسَوْفَ","e":"And soon, surely"},{"p":2,"a":"يَرْضَىٰ","e":"he will be pleased"}]}