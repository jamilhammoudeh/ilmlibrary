{"112:1":[{"p":1,"a":"قُلْ","e":"Say"},{"p":2,"a":"هُوَ","e":"He"},{"p":3,"a":"ٱللَّهُ","e":"(is) Allah"},{"p":4,"a":"أَحَدٌ","e":"the One"}],"112:2":[{"p":1,"a":"ٱللَّهُ","e":"Allah"},{"p":2,"a":"ٱلصَّمَدُ","e":"the Eternal, the Absolute"}],"112:3":[{"p":1,"a":"لَمْ","e":"Not"},{"p":2,"a":"يَلِدْ","e":"He begets"},{"p":3,"a":"وَلَمْ","e":"and not"},{"p":4,"a":"يُولَدْ","e":"He is begotten"}],"112:4":[{"p":1,"a":"وَلَمْ","e":"And not"},{"p":2,"a":"يَكُن","e":"is"},{"p":3,"a":"لَّهُۥ","e":"for Him"},{"p":4,"a":"كُفُوًا","e":"equivalent"},{"p":5,"a":"أَحَدٌۢ","e":"any [one]"}]}