{"87:1":[{"p":1,"a":"سَبِّحِ","e":"Glorify"},{"p":2,"a":"ٱسْمَ","e":"(the) name"},{"p":3,"a":"رَبِّكَ","e":"(of) your Lord"},{"p":4,"a":"ٱلْأَعْلَى","e":"the Most High"}],"87:2":[{"p":1,"a":"ٱلَّذِى","e":"The One Who"},{"p":2,"a":"خَلَقَ","e":"created"},{"p":3,"a":"فَسَوَّىٰ","e":"then proportioned"}],"87:3":[{"p":1,"a":"وَٱلَّذِى","e":"And the One Who"},{"p":2,"a":"قَدَّرَ","e":"measured"},{"p":3,"a":"فَهَدَىٰ","e":"then guided"}],"87:4":[{"p":1,"a":"وَٱلَّذِىٓ","e":"And the One Who"},{"p":2,"a":"أَخْرَجَ","e":"brings forth"},{"p":3,"a":"ٱلْمَرْعَىٰ","e":"the pasture"}],"87:5":[{"p":1,"a":"فَجَعَلَهُۥ","e":"And then makes it"},{"p":2,"a":"غُثَآءً","e":"stubble"},{"p":3,"a":"أَحْوَىٰ","e":"dark"}],"87:6":[{"p":1,"a":"سَنُقْرِئُكَ","e":"We will make you recite"},{"p":2,"a":"فَلَا","e":"so not"},{"p":3,"a":"تَنسَىٰٓ","e":"you will forget"}],"87:7":[{"p":1,"a":"إِلَّا","e":"Except"},{"p":2,"a":"مَا","e":"what"},{"p":3,"a":"شَآءَ","e":"wills"},{"p":4,"a":"ٱللَّهُ ۚ","e":"Allah"},{"p":5,"a":"إِنَّهُۥ","e":"Indeed, He"},{"p":6,"a":"يَعْلَمُ","e":"knows"},{"p":7,"a":"ٱلْجَهْرَ","e":"the manifest"},{"p":8,"a":"وَمَا","e":"and what"},{"p":9,"a":"يَخْفَىٰ","e":"is hidden"}],"87:8":[{"p":1,"a":"وَنُيَسِّرُكَ","e":"And We will ease you"},{"p":2,"a":"لِلْيُسْرَىٰ","e":"to the ease"}],"87:9":[{"p":1,"a":"فَذَكِّرْ","e":"So remind"},{"p":2,"a":"إِن","e":"if"},{"p":3,"a":"نَّفَعَتِ","e":"benefits"},{"p":4,"a":"ٱلذِّكْرَىٰ","e":"the reminder"}],"87:10":[{"p":1,"a":"سَيَذَّكَّرُ","e":"He will pay heed "},{"p":2,"a":"مَن","e":"(one) who"},{"p":3,"a":"يَخْشَىٰ","e":"fears (Allah)"}],"87:11":[{"p":1,"a":"وَيَتَجَنَّبُهَا","e":"And will avoid it"},{"p":2,"a":"ٱلْأَشْقَى","e":"the wretched one"}],"87:12":[{"p":1,"a":"ٱلَّذِى","e":"The one who"},{"p":2,"a":"يَصْلَى","e":"will burn"},{"p":3,"a":"ٱلنَّارَ","e":"(in) the Fire"},{"p":4,"a":"ٱلْكُبْرَىٰ","e":"[the] great"}],"87:13":[{"p":1,"a":"ثُمَّ","e":"Then"},{"p":2,"a":"لَا","e":"not"},{"p":3,"a":"يَمُوتُ","e":"he will die"},{"p":4,"a":"فِيهَا","e":"therein"},{"p":5,"a":"وَلَا","e":"and not"},{"p":6,"a":"يَحْيَىٰ","e":"will live"}],"87:14":[{"p":1,"a":"قَدْ","e":"Certainly"},{"p":2,"a":"أَفْلَحَ","e":"has succeeded"},{"p":3,"a":"مَن","e":"(one) who"},{"p":4,"a":"تَزَكَّىٰ","e":"purifies (himself)"}],"87:15":[{"p":1,"a":"وَذَكَرَ","e":"And remembers"},{"p":2,"a":"ٱسْمَ","e":"(the) name"},{"p":3,"a":"رَبِّهِۦ","e":"(of) his Lord"},{"p":4,"a":"فَصَلَّىٰ","e":"and prays"}],"87:16":[{"p":1,"a":"بَلْ","e":"Nay"},{"p":2,"a":"تُؤْثِرُونَ","e":"You prefer"},{"p":3,"a":"ٱلْحَيَوٰةَ","e":"the life"},{"p":4,"a":"ٱلدُّنْيَا","e":"(of) the world"}],"87:17":[{"p":1,"a":"وَٱلْـَٔاخِرَةُ","e":"While the Hereafter"},{"p":2,"a":"خَيْرٌۭ","e":"(is) better"},{"p":3,"a":"وَأَبْقَىٰٓ","e":"and everlasting"}],"87:18":[{"p":1,"a":"إِنَّ","e":"Indeed"},{"p":2,"a":"هَـٰذَا","e":"this"},{"p":3,"a":"لَفِى","e":"surely (is) in"},{"p":4,"a":"ٱلصُّحُفِ","e":"the Scriptures"},{"p":5,"a":"ٱلْأُولَىٰ","e":"[the] former"}],"87:19":[{"p":1,"a":"صُحُفِ","e":"(The) Scriptures"},{"p":2,"a":"إِبْرَٰهِيمَ","e":"(of) Ibrahim"},{"p":3,"a":"وَمُوسَىٰ","e":"and Musa"}]}