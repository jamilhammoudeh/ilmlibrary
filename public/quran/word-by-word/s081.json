{"81:1":[{"p":1,"a":"إِذَا","e":"When"},{"p":2,"a":"ٱلشَّمْسُ","e":"the sun"},{"p":3,"a":"كُوِّرَتْ","e":"is wrapped up"}],"81:2":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلنُّجُومُ","e":"the stars"},{"p":3,"a":"ٱنكَدَرَتْ","e":"fall, losing their luster"}],"81:3":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْجِبَالُ","e":"the mountains"},{"p":3,"a":"سُيِّرَتْ","e":"are moved away"}],"81:4":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْعِشَارُ","e":"the full-term she-camels"},{"p":3,"a":"عُطِّلَتْ","e":"(are) left untended"}],"81:5":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْوُحُوشُ","e":"the wild beasts"},{"p":3,"a":"حُشِرَتْ","e":"are gathered"}],"81:6":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْبِحَارُ","e":"the seas"},{"p":3,"a":"سُجِّرَتْ","e":"are made to overflow"}],"81:7":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلنُّفُوسُ","e":"the souls"},{"p":3,"a":"زُوِّجَتْ","e":"are paired"}],"81:8":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْمَوْءُۥدَةُ","e":"the female infant buried alive"},{"p":3,"a":"سُئِلَتْ","e":"is asked"}],"81:9":[{"p":1,"a":"بِأَىِّ","e":"For what"},{"p":2,"a":"ذَنۢبٍۢ","e":"sin"},{"p":3,"a":"قُتِلَتْ","e":"she was killed"}],"81:10":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلصُّحُفُ","e":"the pages"},{"p":3,"a":"نُشِرَتْ","e":"are laid open"}],"81:11":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلسَّمَآءُ","e":"the sky"},{"p":3,"a":"كُشِطَتْ","e":"is stripped away"}],"81:12":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْجَحِيمُ","e":"the Hellfire"},{"p":3,"a":"سُعِّرَتْ","e":"is set ablaze"}],"81:13":[{"p":1,"a":"وَإِذَا","e":"And when"},{"p":2,"a":"ٱلْجَنَّةُ","e":"Paradise"},{"p":3,"a":"أُزْلِفَتْ","e":"is brought near"}],"81:14":[{"p":1,"a":"عَلِمَتْ","e":"Will know"},{"p":2,"a":"نَفْسٌۭ","e":"a soul"},{"p":3,"a":"مَّآ","e":"what"},{"p":4,"a":"أَحْضَرَتْ","e":"it has brought"}],"81:15":[{"p":1,"a":"فَلَآ","e":"But nay"},{"p":2,"a":"أُقْسِمُ","e":"I swear"},{"p":3,"a":"بِٱلْخُنَّسِ","e":"by the retreating planets"}],"81:16":[{"p":1,"a":"ٱلْجَوَارِ","e":"Those that run"},{"p":2,"a":"ٱلْكُنَّسِ","e":"(and) disappear"}],"81:17":[{"p":1,"a":"وَٱلَّيْلِ","e":"And the night"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"عَسْعَسَ","e":"it departs"}],"81:18":[{"p":1,"a":"وَٱلصُّبْحِ","e":"And the dawn"},{"p":2,"a":"إِذَا","e":"when"},{"p":3,"a":"تَنَفَّسَ","e":"it breathes"}],"81:19":[{"p":1,"a":"إِنَّهُۥ","e":"Indeed, it"},{"p":2,"a":"لَقَوْلُ","e":"(is) surely a word"},{"p":3,"a":"رَسُولٍۢ","e":"(of) a Messenger"},{"p":4,"a":"كَرِيمٍۢ","e":"noble"}],"81:20":[{"p":1,"a":"ذِى","e":"Possessor of"},{"p":2,"a":"قُوَّةٍ","e":"power"},{"p":3,"a":"عِندَ","e":"with"},{"p":4,"a":"ذِى","e":"(the) Owner of"},{"p":5,"a":"ٱلْعَرْشِ","e":"the Throne"},{"p":6,"a":"مَكِينٍۢ","e":"secure"}],"81:21":[{"p":1,"a":"مُّطَاعٍۢ","e":"One to be obeyed"},{"p":2,"a":"ثَمَّ","e":"and"},{"p":3,"a":"أَمِينٍۢ","e":"trustworthy"}],"81:22":[{"p":1,"a":"وَمَا","e":"And not"},{"p":2,"a":"صَاحِبُكُم","e":"(is) your companion"},{"p":3,"a":"بِمَجْنُونٍۢ","e":"mad"}],"81:23":[{"p":1,"a":"وَلَقَدْ","e":"And certainly"},{"p":2,"a":"رَءَاهُ","e":"he saw him"},{"p":3,"a":"بِٱلْأُفُقِ","e":"in the horizon"},{"p":4,"a":"ٱلْمُبِينِ","e":"the clear"}],"81:24":[{"p":1,"a":"وَمَا","e":"And not"},{"p":2,"a":"هُوَ","e":"he (is)"},{"p":3,"a":"عَلَى","e":"on"},{"p":4,"a":"ٱلْغَيْبِ","e":"the unseen"},{"p":5,"a":"بِضَنِينٍۢ","e":"a withholder"}],"81:25":[{"p":1,"a":"وَمَا","e":"And not"},{"p":2,"a":"هُوَ","e":"it"},{"p":3,"a":"بِقَوْلِ","e":"(is the) word"},{"p":4,"a":"شَيْطَـٰنٍۢ","e":"(of) Shaitaan"},{"p":5,"a":"رَّجِيمٍۢ","e":"accursed"}],"81:26":[{"p":1,"a":"فَأَيْنَ","e":"So where"},{"p":2,"a":"تَذْهَبُونَ","e":"are you going"}],"81:27":[{"p":1,"a":"إِنْ","e":"Not"},{"p":2,"a":"هُوَ","e":"it"},{"p":3,"a":"إِلَّا","e":"(is) except"},{"p":4,"a":"ذِكْرٌۭ","e":"a reminder"},{"p":5,"a":"لِّلْعَـٰلَمِينَ","e":"to the worlds"}],"81:28":[{"p":1,"a":"لِمَن","e":"For whoever"},{"p":2,"a":"شَآءَ","e":"wills"},{"p":3,"a":"مِنكُمْ","e":"among you"},{"p":4,"a":"أَن","e":"to"},{"p":5,"a":"يَسْتَقِيمَ","e":"take a straight way"}],"81:29":[{"p":1,"a":"وَمَا","e":"And not"},{"p":2,"a":"تَشَآءُونَ","e":"you will"},{"p":3,"a":"إِلَّآ","e":"except"},{"p":4,"a":"أَن","e":"that"},{"p":5,"a":"يَشَآءَ","e":"wills"},{"p":6,"a":"ٱللَّهُ","e":"Allah"},{"p":7,"a":"رَبُّ","e":"Lord"},{"p":8,"a":"ٱلْعَـٰلَمِينَ","e":"(of) the worlds"}]}