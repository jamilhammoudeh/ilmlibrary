{"108:1":[{"p":1,"a":"إِنَّآ","e":"Indeed, We"},{"p":2,"a":"أَعْطَيْنَـٰكَ","e":"We have given you"},{"p":3,"a":"ٱلْكَوْثَرَ","e":"Al-Kauthar"}],"108:2":[{"p":1,"a":"فَصَلِّ","e":"So pray"},{"p":2,"a":"لِرَبِّكَ","e":"to your Lord"},{"p":3,"a":"وَٱنْحَرْ","e":"and sacrifice"}],"108:3":[{"p":1,"a":"إِنَّ","e":"Indeed"},{"p":2,"a":"شَانِئَكَ","e":"your enemy "},{"p":3,"a":"هُوَ","e":"he (is)"},{"p":4,"a":"ٱلْأَبْتَرُ","e":"the one cut off"}]}